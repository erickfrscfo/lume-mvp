generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// EMPRESA
// ============================================
model Company {
  id        String   @id @default(cuid())
  name      String
  cnpj      String   @unique
  sector    String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  transactions Transaction[]
  scenarios    Scenario[]
  alerts       Alert[]
  counterparties  Counterparty[]
  documents       Document[]
  reconciliations Reconciliation[]

  @@index([code])
  @@index([cnpj])
}

// ============================================
// USUÁRIO
// ============================================
model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  email     String   @unique
  password  String
  role      Role     @default(USER)
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company          @relation(fields: [companyId], references: [id])
  uploads        Upload[]
  aiInteractions AiInteraction[]

  @@index([username])
  @@index([email])
  @@index([companyId])
}

enum Role {
  ADMIN
  USER
}

// ============================================
// UPLOAD DE ARQUIVOS
// ============================================
model Upload {
  id           String       @id @default(cuid())
  userId       String
  filename     String
  originalName String
  status       UploadStatus @default(PROCESSING)
  rowCount     Int          @default(0)
  errorCount   Int          @default(0)
  errorDetails Json?
  createdAt    DateTime     @default(now())

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@index([userId])
}

enum UploadStatus {
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

// ============================================
// CATEGORIAS CONTÁBEIS
// ============================================
model Category {
  id          String          @id @default(cuid())
  name        String
  type        TransactionType
  parentId    String?
  description String?
  code        String          @unique
  isDefault   Boolean         @default(true)

  parent       Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[]    @relation("CategoryHierarchy")
  transactions Transaction[]

  @@index([type])
  @@index([parentId])
}

// ============================================
// TRANSAÇÕES FINANCEIRAS
// ============================================
model Transaction {
  id              String          @id @default(cuid())
  companyId       String
  uploadId        String?
  date            DateTime
  description     String
  amount          Decimal         @db.Decimal(15, 2)
  tipo_transacao  TransactionType // RENOMEADO: era "type"
  categoryId      String?
  aiClassified    Boolean         @default(false)
  confidence      Decimal?        @db.Decimal(3, 2)
  tipo_custo      CostType?       // NOVO CAMPO: classifica custo como fixo ou variável
  costConfidence  Decimal?        @db.Decimal(3, 2) // NOVO: confiança da classificação de custo
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  upload   Upload?   @relation(fields: [uploadId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])

  @@index([companyId, date])
  @@index([companyId, tipo_transacao])
  @@index([categoryId])
  @@index([uploadId])
  @@index([tipo_custo]) // NOVO: índice para filtrar por tipo de custo
  detail TransactionDetail?
}

enum TransactionType {
  INCOME
  EXPENSE
}

// NOVO ENUM: Tipo de Custo (Fixo ou Variável)
enum CostType {
  FIXO      // Custos fixos: aluguel, salários, assinaturas
  VARIAVEL  // Custos variáveis: comissões, matéria-prima, frete
}

// ============================================
// CENÁRIOS FINANCEIROS
// ============================================
model Scenario {
  id          String       @id @default(cuid())
  companyId   String
  name        String
  type        ScenarioType
  description String?
  adjustments Json
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

enum ScenarioType {
  PROJECT
  ORGANIZATIONAL_CHANGE
  INVESTMENT
  DIVESTMENT
}

// ============================================
// INTERAÇÕES COM IA
// ============================================
model AiInteraction {
  id               String            @id @default(cuid())
  userId           String
  type             AiInteractionType
  promptTemplateId String?
  promptSent       String
  responseReceived String
  tokenUsage       Json
  model            String
  latencyMs        Int
  createdAt        DateTime          @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

enum AiInteractionType {
  CLASSIFICATION
  EXPLANATION
  CHAT
  ANALYSIS
  COST_CLASSIFICATION // NOVO: tipo de interação para classificação de custos
}

// ============================================
// TEMPLATES DE PROMPTS
// ============================================
model PromptTemplate {
  id        String            @id @default(cuid())
  name      String
  type      AiInteractionType
  version   Int               @default(1)
  content   String
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())

  @@unique([name, version])
  @@index([type, isActive])
}

// ============================================
// ALERTAS INTELIGENTES
// ============================================
model Alert {
  id               String    @id @default(cuid())
  companyId        String
  type             String
  severity         String    @default("MEDIUM")
  title            String
  rawData          Json      @default("{}")
  templateText     String    @default("")
  humanizedText    String?
  category         String?
  potentialSavings Float?
  isRead           Boolean   @default(false)
  isDismissed      Boolean   @default(false)
  dataHash         String?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, isDismissed])
  @@index([dataHash])
}
// =============================================
// NOVOS MODELOS - MVP v2 Conciliação
// Adicionar ao final do schema.prisma existente
// =============================================

// =============================================
// CONTRAPARTES (Fornecedores/Clientes)
// =============================================
model Counterparty {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  document    String?  // CNPJ ou CPF
  type        CounterpartyType @default(SUPPLIER)
  email       String?
  phone       String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactionDetails TransactionDetail[]
  documents   Document[]

  @@index([companyId])
  @@index([companyId, type])
  @@index([document])
}

enum CounterpartyType {
  SUPPLIER
  CLIENT
  BOTH
}

// =============================================
// DETALHES DE TRANSAÇÃO (para conciliação)
// =============================================
model TransactionDetail {
  id                   String               @id @default(cuid())
  transactionId        String
  counterpartyId       String?
  reconciliationStatus ReconciliationStatus @default(PENDING)
  dueDate              DateTime?
  paymentDate          DateTime?
  documentNumber       String?
  bankReference        String?
  notes                String?
  reconciledBy         String?              // userId de quem conciliou
  reconciledAt         DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  transaction    Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id])
  reconciliation Reconciliation?

  @@unique([transactionId])
  @@index([reconciliationStatus])
  @@index([counterpartyId])
  @@index([dueDate])
}

enum ReconciliationStatus {
  PENDING
  RECONCILED
  DIVERGENT
  PARTIAL
}

// =============================================
// DOCUMENTOS FISCAIS
// =============================================
model Document {
  id              String       @id @default(cuid())
  companyId       String
  counterpartyId  String?
  type            DocumentType
  number          String
  issueDate       DateTime
  amount          Decimal      @db.Decimal(15, 2)
  description     String?
  fileUrl         String?
  status          DocumentStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  counterparty Counterparty? @relation(fields: [counterpartyId], references: [id])
  reconciliation Reconciliation?

  @@index([companyId])
  @@index([companyId, type])
  @@index([counterpartyId])
  @@index([number])
}

enum DocumentType {
  INVOICE
  RECEIPT
  BANK_STATEMENT
  CONTRACT
  OTHER
}

enum DocumentStatus {
  ACTIVE
  CANCELLED
  ARCHIVED
}

// =============================================
// CONCILIAÇÃO
// =============================================
model Reconciliation {
  id                  String   @id @default(cuid())
  companyId           String
  transactionDetailId String   @unique
  documentId          String?  @unique
  method              ReconciliationMethod @default(MANUAL)
  confidence          Decimal? @db.Decimal(3, 2)
  notes               String?
  reconciledBy        String   // userId
  createdAt           DateTime @default(now())

  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactionDetail TransactionDetail @relation(fields: [transactionDetailId], references: [id], onDelete: Cascade)
  document          Document?         @relation(fields: [documentId], references: [id])

  @@index([companyId])
  @@index([companyId, createdAt])
}

enum ReconciliationMethod {
  MANUAL
  AUTO_EXACT
  AUTO_FUZZY
  AI_SUGGESTED
}

