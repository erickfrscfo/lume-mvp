generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// EMPRESA
// ============================================
enum CompanySector {
  VAREJO      // Varejo / Comércio
  SERVICOS    // Serviços / Consultoria
  INDUSTRIA   // Indústria / Manufatura
  SAAS        // SaaS / Tecnologia
  MISTO       // Misto / Outros
}

model Company {
  id        String        @id @default(cuid())
  name      String
  cnpj      String        @unique
  sector    CompanySector @default(MISTO)
  code      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  users          User[]
  transactions   Transaction[]
  scenarios      Scenario[]
  alerts         Alert[]
  counterparties Counterparty[]
  documents      Document[]
  aiInsights     AiInsight[]

  @@index([code])
  @@index([cnpj])
}

// ============================================
// USUÁRIO
// ============================================
model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  email     String   @unique
  password  String
  role      Role     @default(USER)
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company          @relation(fields: [companyId], references: [id])
  uploads        Upload[]
  aiInteractions AiInteraction[]

  @@index([username])
  @@index([email])
  @@index([companyId])
}

enum Role {
  ADMIN
  USER
}

// ============================================
// UPLOAD DE ARQUIVOS
// ============================================
model Upload {
  id           String       @id @default(cuid())
  userId       String
  filename     String
  originalName String
  status       UploadStatus @default(PROCESSING)
  rowCount     Int          @default(0)
  errorCount   Int          @default(0)
  errorDetails Json?
  createdAt    DateTime     @default(now())

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@index([userId])
}

enum UploadStatus {
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

// ============================================
// CATEGORIAS CONTÁBEIS
// ============================================
model Category {
  id          String          @id @default(cuid())
  name        String
  type        TransactionType
  parentId    String?
  description String?
  code        String          @unique
  isDefault   Boolean         @default(true)

  parent       Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[]    @relation("CategoryHierarchy")
  transactions Transaction[]

  @@index([type])
  @@index([parentId])
}

// ============================================
// CONTRAPARTES (Fornecedores / Clientes)
// ============================================
model Counterparty {
  id                String           @id @default(cuid())
  companyId         String
  name              String
  document          String?          // CNPJ ou CPF
  type              CounterpartyType @default(SUPPLIER)
  email             String?
  phone             String?
  address           String?
  notes             String?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  avgDaysToPay      Decimal?
  avgDaysToReceive  Decimal?
  latePaymentCount  Int              @default(0)
  totalTransactions Int              @default(0)
  reliabilityScore  Decimal?

  company            Company             @relation(fields: [companyId], references: [id])
  transactions       Transaction[]
  transactionDetails TransactionDetail[]
  documents          Document[]
  aiInsights         AiInsight[]

  @@index([companyId])
  @@index([companyId, isActive])
  @@index([companyId, type])
}

enum CounterpartyType {
  SUPPLIER
  CLIENT
  BOTH
}

// ============================================
// TRANSAÇÕES FINANCEIRAS
// ============================================
model Transaction {
  id              String            @id @default(cuid())
  companyId       String
  uploadId        String?
  date            DateTime
  description     String
  amount          Decimal           @db.Decimal(15, 2)
  tipo_transacao  TransactionType
  categoryId      String?
  aiClassified    Boolean           @default(false)
  confidence      Decimal?          @db.Decimal(3, 2)
  tipo_custo      CostType?
  costConfidence  Decimal?          @db.Decimal(3, 2)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  status          TransactionStatus @default(PENDING)
  source          TransactionSource @default(MANUAL)
  counterpartyId  String?
  documentId      String?

  company      Company            @relation(fields: [companyId], references: [id])
  upload       Upload?            @relation(fields: [uploadId], references: [id])
  category     Category?          @relation(fields: [categoryId], references: [id])
  counterparty Counterparty?      @relation(fields: [counterpartyId], references: [id])
  detail       TransactionDetail?

  @@index([companyId, date])
  @@index([companyId, tipo_transacao])
  @@index([categoryId])
  @@index([uploadId])
  @@index([tipo_custo])
  @@index([counterpartyId])
  @@index([status])
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  OVERDUE
  PARTIAL
}

enum TransactionSource {
  MANUAL
  UPLOAD
  OCR
  BANK_SYNC
}

enum CostType {
  FIXO
  VARIAVEL
}

// ============================================
// DETALHES DE TRANSAÇÃO (Conciliação)
// ============================================
model TransactionDetail {
  id                   String               @id @default(cuid())
  transactionId        String               @unique
  reconciliationStatus ReconciliationStatus @default(PENDING)
  dueDate              DateTime?
  paymentDate          DateTime?
  receiptDate          DateTime?
  documentNumber       String?
  bankReference        String?
  amountOriginal       Decimal?             @db.Decimal(15, 2)
  amountPaid           Decimal?             @db.Decimal(15, 2)
  amountReceived       Decimal?             @db.Decimal(15, 2)
  discount             Decimal?             @db.Decimal(15, 2)
  interest             Decimal?             @db.Decimal(15, 2)
  counterpartyId       String?
  notes                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  transaction  Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  counterparty Counterparty? @relation(fields: [counterpartyId], references: [id])

  @@index([reconciliationStatus])
  @@index([counterpartyId])
}

enum ReconciliationStatus {
  PENDING
  RECONCILED
  DIVERGENT
  PARTIAL
}

enum ReconciliationMethod {
  MANUAL
  AUTO_EXACT
  AUTO_FUZZY
  AI_SUGGESTED
}

enum ReconciliationConfirmStatus {
  SUGGESTED
  CONFIRMED
  REJECTED
}

// ============================================
// DOCUMENTOS FISCAIS
// ============================================
model Document {
  id                    String         @id @default(cuid())
  companyId             String
  number                String
  type                  DocumentType   @default(OTHER)
  description           String?
  amount                Decimal?       @db.Decimal(15, 2)
  issueDate             DateTime?
  dueDate               DateTime?
  status                DocumentStatus @default(ACTIVE)
  counterpartyId        String?
  notes                 String?
  fileName              String?
  fileType              String?
  fileSize              Int?
  extractedData         Json?
  extractionConfidence  Float?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  company      Company       @relation(fields: [companyId], references: [id])
  counterparty Counterparty? @relation(fields: [counterpartyId], references: [id])

  @@index([companyId])
  @@index([companyId, type])
  @@index([counterpartyId])
}

enum DocumentType {
  INVOICE
  RECEIPT
  BANK_STATEMENT
  CONTRACT
  OTHER
}

enum DocumentStatus {
  ACTIVE
  CANCELLED
  ARCHIVED
}

// ============================================
// CENÁRIOS FINANCEIROS
// ============================================
model Scenario {
  id          String       @id @default(cuid())
  companyId   String
  name        String
  type        ScenarioType
  description String?
  adjustments Json
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

enum ScenarioType {
  PROJECT
  ORGANIZATIONAL_CHANGE
  INVESTMENT
  DIVESTMENT
}

// ============================================
// INTERAÇÕES COM IA
// ============================================
model AiInteraction {
  id               String            @id @default(cuid())
  userId           String
  type             AiInteractionType
  promptTemplateId String?
  promptSent       String
  responseReceived String
  tokenUsage       Json
  model            String
  latencyMs        Int
  createdAt        DateTime          @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

enum AiInteractionType {
  CLASSIFICATION
  EXPLANATION
  CHAT
  ANALYSIS
  COST_CLASSIFICATION
}

// ============================================
// TEMPLATES DE PROMPTS
// ============================================
model PromptTemplate {
  id        String            @id @default(cuid())
  name      String
  type      AiInteractionType
  version   Int               @default(1)
  content   String
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())

  @@unique([name, version])
  @@index([type, isActive])
}

// ============================================
// ALERTAS INTELIGENTES
// ============================================
model Alert {
  id               String    @id @default(cuid())
  companyId        String
  type             String
  severity         String    @default("MEDIUM")
  title            String
  rawData          Json      @default("{}")
  templateText     String    @default("")
  humanizedText    String?
  category         String?
  potentialSavings Float?
  isRead           Boolean   @default(false)
  isDismissed      Boolean   @default(false)
  dataHash         String?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, isDismissed])
  @@index([dataHash])
}

// ============================================
// AI INSIGHTS (Conciliação)
// ============================================
model AiInsight {
  id                      String    @id @default(cuid())
  companyId               String
  insightType             String
  severity                String    @default("MEDIUM")
  title                   String
  description             String?
  recommendation          String?
  relatedTransactionIds   String[]  @default([])
  relatedCounterpartyId   String?
  metadata                Json      @default("{}")
  potentialImpact         Decimal?
  potentialSavings        Decimal?
  isRead                  Boolean   @default(false)
  isDismissed             Boolean   @default(false)
  readAt                  DateTime?
  actedAt                 DateTime?
  expiresAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  company      Company       @relation(fields: [companyId], references: [id])
  counterparty Counterparty? @relation(fields: [relatedCounterpartyId], references: [id])

  @@index([companyId])
  @@index([companyId, isDismissed])
  @@index([insightType])
}
