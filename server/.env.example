# ============================================
# LUME MVP - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA compartilhe o arquivo .env com ninguém!

# Banco de Dados PostgreSQL (Railway fornece automaticamente)
DATABASE_URL="postgresql://usuario:senha@host:porta/nome_banco?sslmode=require"

# Segredo para gerar tokens JWT (gere um aleatório com 32+ caracteres)
JWT_SECRET="gere-uma-string-aleatoria-com-pelo-menos-32-caracteres-aqui"
JWT_EXPIRES_IN="7d"

# Chave da API OpenAI (obtenha em https://platform.openai.com/api-keys)
OPENAI_API_KEY="sk-sua-chave-aqui"

# Porta do servidor (Railway define automaticamente)
PORT=3001

# Ambiente
NODE_ENV="development"

# URL do frontend (para CORS)
CORS_ORIGIN="http://localhost:5173"
